  m_Script: {fileID: 11500000, guid: 395b59f24300f7e43a5a63da0c605cc7, type: 3}
  m_Name: Dialogue3
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - avatar: {fileID: 21300000, guid: 8293de3f1bb94bf4baf3a7d5cd3aff72, type: 3}
    content: Well... here you go. I hope they're at least edible, Kaguya.
  - avatar: {fileID: 21300000, guid: 5a472bed8c925d54c88c9848f2e0dd82, type: 3}
    content: (Takes a thoughtful bite.) Hmm... they're not quite fluffy, and a little
      dense.
  - avatar: {fileID: 21300000, guid: 8293de3f1bb94bf4baf3a7d5cd3aff72, type: 3}
    content: (Disappointed) I see...
  - avatar: {fileID: 21300000, guid: 5a472bed8c925d54c88c9848f2e0dd82, type: 3}
    content: But... they have a very honest, handmade taste. They taste like you.
  - avatar: {fileID: 21300000, guid: 8293de3f1bb94bf4baf3a7d5cd3aff72, type: 3}
    content: Like me...?
  - avatar: {fileID: 21300000, guid: 5a472bed8c925d54c88c9848f2e0dd82, type: 3}
    content: Yes. A little clumsy, but full of warmth. Thank you, Iroha. I'll finish
      them all.
